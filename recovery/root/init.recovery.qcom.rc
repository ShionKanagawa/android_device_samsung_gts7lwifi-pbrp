import /init.recovery.qcom_decrypt.rc
import /init.recovery.display.rc

on early-init
    start linkblobs

on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop prepdecrypt.setpatch true
    setprop prepdecrypt.loglevel 2

on post-fs
    mkdir /mnt/vendor/efs/DAK 0775 system system
    restorecon -R /mnt/vendor/efs/DAK
    chown system system /mnt/vendor/efs/DAK/gakkeybox
    chmod 0644 /mnt/vendor/efs/DAK/gakkeybox

on post-fs-data
    mkdir /data/vendor/keymaster 0775 system system

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # Mount firmware
    mkdir /vendor/firmware_mnt
    mount vfat /dev/block/bootdevice/by-name/apnhlos /vendor/firmware_mnt ro

on boot
    start health-hal-2-1

on property:crypto.ready=1
    start keymaster-sb-4-0

on property:crypto.ready=0
    stop keymaster-sb-4-0

service linkblobs /system/bin/linkblobs.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0


service keymaster-sb-4-0 /system/bin/hw/android.hardware.keymaster@4.0-strongbox-service-qti
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0
